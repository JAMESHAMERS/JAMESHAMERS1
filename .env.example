# Supabase project credentials (Project Settings → API).
# Safe to expose to the browser: scoped by Row Level Security, not secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic API key (console.anthropic.com) for the AI Assistant module.
# Server-only — never prefix with NEXT_PUBLIC_, never read from client code.
# Optional: without it, the Assistant still answers using its local
# deterministic engine (see src/modules/assistant/README.md).
ANTHROPIC_API_KEY=
